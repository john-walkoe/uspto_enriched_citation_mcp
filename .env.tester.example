# API Keys for USPTO Enriched Citation MCP — Live Integration Testing
# Copy this file to .env.tester and fill in your actual key.
# .env.tester is gitignored — never commit it.
# After creating: chmod 600 .env.tester
#
# Without this file, integration tests that make live API calls are skipped.
# Unit, security, and resilience tests run without it.

# Required for all live API tests
USPTO_API_KEY=your_uspto_api_key_here
