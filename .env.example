# USPTO Enriched Citation MCP — Docker environment template
# Copy to .env and fill in your values:
#   cp .env.example .env

# Required
USPTO_API_KEY=your_30_char_lowercase_key_here

# Required for FASTMCP_TRANSPORT=http with CITATIONS_AUTH_MODE=none (plain
# HTTP): the x-api-key guard on every non-health request. The server refuses
# to start in that mode without it (SystemExit) — set this OR switch to
# CITATIONS_AUTH_MODE=oauth, which is bearer-protected instead.
# May be a comma-separated list, current value first ("new,old"), for a
# rotation overlap window instead of a synchronized four-service restart
# (S-06, PT-14) — see scripts/rotate_internal_auth_secret.py.
# INTERNAL_AUTH_SECRET=your_shared_secret_here

# Optional — add when exposing directly to claude.ai via reverse proxy
# CORS_EXTRA_ORIGIN=https://claude.ai

# Optional — additional CSP domain(s) for MCP Apps iframe (comma-separated)
# MCP_APP_EXTRA_DOMAINS=https://your-proxy.example.com

# Optional — override transport (default is http, set in Dockerfile)
# FASTMCP_TRANSPORT=http
# FASTMCP_HOST=0.0.0.0
# FASTMCP_PORT=8000

# Optional — stateless streamable HTTP (default true; set false to keep a
# server-side session table)
# FASTMCP_STATELESS_HTTP=true

# Optional — rate limit (requests per minute, default 100)
# ECITATION_RATE_LIMIT=100

# Optional — trusted reverse-proxy IPs/CIDRs (comma-separated). Also read by
# uvicorn's own forwarded_allow_ips (S-08). Empty (default) trusts nobody: no
# forwarded header is consulted anywhere, and the OAuth-route limiters plus
# the inbound /mcp limiter key on the raw ASGI peer — the proxy's one address
# for every caller when this server sits behind a reverse proxy (CR-01, review
# 2026-09-28). Once the immediate peer is trusted, CF-Connecting-IP is
# preferred (X-Forwarded-For's rightmost non-proxy hop is the fallback) and
# the resolved address is what every limiter actually keys on. Never "*" —
# see server_bootstrap.py. Example: a Cloudflare tunnel -> reverse proxy ->
# this container, all on one docker network such as 172.18.0.0/16, takes
# TRUSTED_PROXY_IPS=172.18.0.0/16.
# TRUSTED_PROXY_IPS=

# Optional — logging verbosity (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# =============================================================================
# Shared USPTO rate limiting (off by default)
# =============================================================================
# All 4 USPTO MCPs (citations/pfw/ptab/fpd) can run as containers sharing one
# host/netns under a SINGLE USPTO API key. USPTO's documented limits are
# per-KEY (burst=1, no parallel requests; 4-15 req/sec by call type; weekly
# quotas), so a per-process limiter can't see what the other 3 processes are
# doing. Setting USPTO_SHARED_RATE_LIMIT_DIR points all of them at one
# bind-mounted directory; a FIFO queue, a cross-process token bucket
# (capacity 1, so two sends are always >= 1/RPS apart) and a bounded pool of
# concurrency slots, all arbitrated via POSIX file locks (flock, released
# automatically by the kernel on process death, so it's crash-safe), keep
# the combined request rate under the shared key's limits. A 429 seen by any
# process is written to cooldown.json in the same directory and every
# process on the key waits max(5 s, Retry-After) before its next send. Leave
# unset for a standalone deployment.
# USPTO_SHARED_RATE_LIMIT_DIR=/var/run/uspto-shared-rate-limit
# USPTO_SHARED_RATE_LIMIT_RPS=4.0       # total tokens/sec across ALL 4 MCPs
# USPTO_SHARED_MAX_CONCURRENT=1         # shared in-flight slots (USPTO burst=1 per key)
# USPTO_SHARED_MAX_WAIT_SECONDS=45      # queue wait ceiling per send; past it the
#                                       # tool answers with the 429 envelope at once

# One end-to-end time budget per Citations_get_citation_statistics call: its
# six count queries and every retry inside them share it, so a slow upstream
# ends with the counts that did return (the rest null, with a deadline_note)
# or a 504 "Deadline exceeded", instead of running past Cloudflare's ~100 s
# cut. Keep it under 100 behind Cloudflare. Every other tool keeps
# CITATIONS_TOOL_DEADLINE (default 45).
# CITATIONS_CONTENT_DEADLINE_SECONDS=85

# =============================================================================
# OAuth sign-in (dual IdP: Google + Entra ID) — HTTP mode only
# =============================================================================
# "none" (default) keeps today's behavior. "oauth" turns the HTTP surface into
# an OAuth 2.1 authorization server: users sign in with Google/Microsoft and
# must have an active row in the mcp_users table (see
# scripts/manage_mcp_users.py and the citations_manage_users tool).
# CITATIONS_AUTH_MODE=oauth
# CITATIONS_AUTH_BASE_URL=https://your-public-hostname.example.com
# CITATIONS_AUTH_JWT_SECRET=  # openssl rand -hex 32 — rotating logs everyone out
# CITATIONS_AUTH_GOOGLE_CLIENT_ID=
# CITATIONS_AUTH_GOOGLE_CLIENT_SECRET=
# CITATIONS_AUTH_MS_CLIENT_ID=
# CITATIONS_AUTH_MS_CLIENT_SECRET=
# CITATIONS_AUTH_MS_TENANT=common  # common | organizations | tenant GUID
# CITATIONS_AUTH_INTERNAL_TOKEN=   # openssl rand -hex 32 — static bearer for headless clients
#                            # (citations:user ONLY — existing internal-gateway
#                            # tokens keep working for the data tools but no
#                            # longer grant citations:admin; this is intended)
# CITATIONS_AUTH_INTERNAL_ADMIN_TOKEN=  # openssl rand -hex 32 — SEPARATE static
#                            # bearer granting citations:user + citations:admin. Issue
#                            # this only to whichever internal caller
#                            # actually needs to manage users; most
#                            # deployments should leave it unset.
# CITATIONS_AUTH_ALLOWED_REDIRECT_HOSTS=   # comma-separated EXTRA hosts allowed to
#                            # dynamically register a redirect_uri. claude.ai,
#                            # claude.com, anthropic.com, chatgpt.com, openai.com,
#                            # localhost and 127.0.0.1 are always allowed
#                            # (subdomains included). Clients already registered
#                            # are unaffected.
# CITATIONS_AUTH_OPEN_REGISTRATION=false   # true restores fully open Dynamic Client
#                            # Registration. Leave false: an arbitrary redirect_uri
#                            # is the first half of an identity-takeover chain.
# CITATIONS_AUTH_REGISTER_URL=     # optional "Request access" link
# CITATIONS_AUTH_ACCESS_TTL=3600
# CITATIONS_AUTH_REFRESH_TTL=2592000
# SQLite file holding users + OAuth state. Point several suite MCPs at ONE
# file (shared bind mount, same host only) for a single user list.
# CITATIONS_AUTH_DB_PATH=data/mcp_auth.db
# CITATIONS_OWNER_EMAILS=     # comma-separated owner accounts, e.g.
#                            # owner@example.com,second@example.org. When set,
#                            # ONLY these accounts can hold citations:admin, the
#                            # scope is stripped at bearer load from tokens
#                            # minted before, and only an owner can grant the
#                            # admin role. Unset keeps roster admins as admins
#                            # (a startup warning says so). Tokens carry the
#                            # scope the client REQUESTED, so a client that
#                            # asks for citations:user only never gets admin.
# Registration gate for the citations_manage_users admin tool. Default false
# (tool is not registered — hidden from tools/list). OAuth deployments MUST
# set this to true or the admin tool disappears with no other symptom.
# CITATIONS_ENABLE_USER_MANAGEMENT=false

# Registration gate for the 5 MCP prompt templates. Default false (no prompts
# are registered — hidden from prompts/list). Set to true to expose the guided
# workflow prompts (see PROMPTS.md).
# CITATIONS_ENABLE_PROMPTS=false
